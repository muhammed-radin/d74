          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Live TV",
      "short_name": "Live",
      "description": "Open live football and sports TV channels",
      "url": "/livestreams/",
      "icons": [
        {
          "src": "/android-chrome-192x192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Search",
      "short_name": "Search",
      "description": "Search the D74 Edits video catalogue",
      "url": "/search/",
      "icons": [
        {
          "src": "/android-chrome-192x192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Settings",
