# ─────────────────────────────────────────────────────────────
#  D74 Edits — environment template
#  Copy this file to `.env` and fill in real values.
#  NEVER commit `.env`.
# ─────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=3005

# Optional: force the public origin and proxy trust for deployments
# PUBLIC_ORIGIN=https://d74edits.example.com
# TRUST_PROXY=1
# CORS_ORIGINS=https://preview.example.com

# ── Sessions ─────────────────────────────────────────────────
# Signs cookies and anonymises analytics. Generate:
#   openssl rand -hex 32
SESSION_SECRET=replace-with-a-long-random-string

# ── Data layer ───────────────────────────────────────────────
# Firebase Firestore is the primary database. All reads and writes
# stay on the server: the browser never receives these credentials.
# DB_PROVIDER=firebase | restdb (legacy, disabled) | local (dev only)
DB_PROVIDER=firebase
FIREBASE_PROJECT_ID=your-firebase-project
# Use ONE of the following service-account layouts:
# 1) Inline JSON (single line) or base64-encoded JSON
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","client_email":"...","private_key":"..."}
# 2) A mounted credentials file
# FIREBASE_SERVICE_ACCOUNT_PATH=/run/secrets/firebase-service-account.json
# 3) Individual values (escape newlines as \n)
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Optional collection prefix (useful for staging + production in one project)
# FIREBASE_COLLECTION_PREFIX=
# Development-only fallback when Firebase is not configured:
# LOCAL_DB_FILE=server/data/local-db.json

# ── Legacy restdb (disabled) ─────────────────────────────────
# Kept for compatibility. Only used when DB_PROVIDER=restdb.
# RESTDB_BASE_URL=https://d74edits-fce6.restdb.io/rest
# RESTDB_API_KEY=your-restdb-api-key

# ── RapidAPI ─────────────────────────────────────────────────
RAPIDAPI_KEY=your-rapidapi-key
YOUTUBE_RAPIDAPI_HOST=youtube-v31.p.rapidapi.com
FOOTBALL_RAPIDAPI_HOST=free-football-soccer-videos.p.rapidapi.com

# One or more YouTube channels, comma separated. The cron sync
# merges them all into the videos collection.
YOUTUBE_CHANNEL_ID=UCFodctpE1wtpFhWw716uCgg
# YOUTUBE_CHANNEL_IDS=UCFodctpE1wtpFhWw716uCgg,SECOND_CHANNEL_ID

# ── Player ───────────────────────────────────────────────────

# ── AdSense ──────────────────────────────────────────────────
# Publisher id and per-placement slot ids. Only validated values
# are exposed through GET /api/config. A missing client or slot
# renders a designed D74 house ad instead of empty ad space.
# ADSENSE_ENABLED=true
# ADSENSE_CLIENT=ca-pub-0000000000000000
# ADSENSE_SLOT_EXPLORE=0000000000
# ADSENSE_SLOT_EXPLORE_INLINE=0000000000
# ADSENSE_SLOT_LIVE=0000000000
# ADSENSE_SLOT_LIVE_SIDE=0000000000

# ── Admin ────────────────────────────────────────────────────
ADMIN_USERNAME=admin
# Prefer ADMIN_PASSWORD_HASH in production. Generate it with:
#   node -e "const a=require('./server/auth');const h=a.hashPassword(process.argv[1]);console.log('scrypt$'+h.salt+'$'+h.hash)" 'your-password'
ADMIN_PASSWORD=use-a-strong-unique-password
# ADMIN_PASSWORD_HASH=scrypt$salt$hash
ADMIN_SESSION_HOURS=12
ADMIN_SESSION_IDLE_MINUTES=45
ADMIN_MAX_SESSIONS=5
# Rotate the CSRF token this often (minutes). The session id is
# regenerated on demand via POST /api/admin/session/rotate.
ADMIN_ROTATE_MINUTES=30
ADMIN_BIND_USER_AGENT=true
ADMIN_BIND_IP=false
# ADMIN_COOKIE_SECURE=true (always enforced in production)
ADMIN_MAX_LOGIN_ATTEMPTS=5
ADMIN_LOGIN_WINDOW_MINUTES=15

# ── Redis (optional, recommended in production) ──────────────
# Without REDIS_URL the server logs "Cache driver: memory" and uses a
# bounded in-process cache. Set REDIS_URL to enable Redis; both the cache
# and (when configured) the admin session store then share state across
# instances.
# REDIS_URL=redis://127.0.0.1:6379
# REDIS_ENABLED=true
# REDIS_TLS=false
CACHE_PREFIX=d74:
CACHE_MAX_ENTRIES=5000

# ── Cache tuning (seconds, except where noted) ───────────────
DB_CACHE_TTL=60
DB_STALE_TTL=300
YOUTUBE_CACHE_TTL=900
YOUTUBE_VIDEO_CACHE_TTL=21600
FOOTBALL_CACHE_TTL=120

# ── Free downloads (YouTube.js primary, yt-dlp fallback) ──────
YOUTUBEJS_ENABLED=true
# ── Free downloads (yt-dlp) ──────────────────────────────────
# Downloads are free: no password and no pre-published link is needed.
# A record with a direct URL uses that URL; otherwise the server runs
# yt-dlp and streams the clip from YouTube as an attachment.
# Install the binary (pip install -U yt-dlp, or apt install yt-dlp) and
# make sure it is on PATH, or point YTDLP_PATH at it.
YTDLP_ENABLED=true
# YTDLP_PATH=/usr/local/bin/yt-dlp
# Export a Netscape cookies file when YouTube asks the server to verify
# it is not a bot (common on cloud/VPS IPs).
# YTDLP_COOKIES=/etc/d74/cookies.txt
# Progressive MP4 keeps streaming to stdout simple. Merged formats need
# ffmpeg and a seekable file, so the default is a single-file stream.
YTDLP_FORMAT=best[ext=mp4]/best
# YTDLP_EXTRACTOR_ARGS=youtube:player_client=web
# YTDLP_EXTRA_ARGS=--no-check-certificates
# YTDLP_START_TIMEOUT_MS=45000
DOWNLOAD_RATE_LIMIT_MAX=30

# ── Quotas ───────────────────────────────────────────────────
# 0 disables a cap. DB_QUOTA_HARD_STOP=true rejects writes when
# the daily database cap is reached instead of only warning.
DB_DAILY_LIMIT=0
DB_QUOTA_HARD_STOP=false
YT_DAILY_LIMIT=500
YT_QUOTA_RESERVE=20

# ── YouTube cron sync ────────────────────────────────────────
YT_SYNC_ENABLED=true
YT_SYNC_ON_START=false
YT_SYNC_CRON=17 */6 * * *
YT_SYNC_TIMEZONE=UTC
YT_SYNC_MAX_NEW=25
YT_SYNC_PAGES=1
YT_SYNC_OVERLAP_HOURS=48
# YT_TIMEOUT_MS=15000

# ── Bulk sync ────────────────────────────────────────────────
# The long-running "Admin → Bulk sync" job loads 30 videos per
# batch, waits between batches and stops at the daily cap.
BULK_BATCH_SIZE=30
BULK_DAILY_LIMIT=300
BULK_DELAY_MINUTES=30

# ── Keep-alive (Render free tier) ────────────────────────────
# Render sleeps a free web service after 15 minutes without an external
# HTTP request. The process pinging itself does not count, so use
# .github/workflows/keep-alive.yml or an external uptime monitor to call
#   https://<your-service>.onrender.com/api/health
# every 10–14 minutes. KEEP_ALIVE_SELF only warms the local process.
# KEEP_ALIVE_SELF=false
# KEEP_ALIVE_INTERVAL_MS=600000

# ── Rate limits ──────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=600
API_RATE_LIMIT_MAX=240
LOGIN_RATE_LIMIT_MAX=12
ADMIN_LOGIN_RATE_LIMIT_MAX=6
UNLOCK_RATE_LIMIT_MAX=25
YOUTUBE_RATE_LIMIT_MAX=60
DB_WRITE_RATE_LIMIT_MAX=90

# ── Analytics ────────────────────────────────────────────────
# ANALYTICS_SALT=replace-with-a-random-salt
ANALYTICS_RECENT_LIMIT=250
ANALYTICS_AUDIT_LIMIT=250
ANALYTICS_TICK_MS=15000

# ── Logging ──────────────────────────────────────────────────
# LOG_LEVEL=debug

# ── Legacy Firebase identifiers (reference only) ─────────────
# The client no longer talks to Firebase directly. These web
# identifiers are optional and not used by the current server.
# FIREBASE_API_KEY=
# FIREBASE_AUTH_DOMAIN=
# FIREBASE_STORAGE_BUCKET=
# FIREBASE_MESSAGING_SENDER_ID=
# FIREBASE_APP_ID=
# FIREBASE_MEASUREMENT_ID=
